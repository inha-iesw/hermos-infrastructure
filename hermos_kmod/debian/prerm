#!/bin/sh
set -e

VERSION="2.3.5"

case "$1" in
    remove|upgrade)
        if command -v dkms >/dev/null 2>&1 && dkms status -m hermos -v "$VERSION" 2>/dev/null | grep -q hermos; then
            dkms remove -m hermos -v "$VERSION" --all >/dev/null 2>&1 || true
        fi
    ;;
esac

#DEBHELPER#

exit 0
