#!/bin/sh

VERSION="2.3.5"

case "$1" in
    configure)
        if dkms status -m hermos -v "$VERSION" 2>/dev/null | grep -q hermos; then
            echo "hermos DKMS version $VERSION is already registered. Skipping."
        else
            if ! dkms add -m hermos -v "$VERSION"; then
                echo "WARNING: DKMS add failed. The hermos kernel module is not available."
                exit 0
            fi

            if ! dkms build -m hermos -v "$VERSION"; then
                echo "WARNING: DKMS build failed for kernel $(uname -r). The hermos kernel module is not available."
                echo "Rolling back DKMS registration."
                dkms remove -m hermos -v "$VERSION" --all 2>/dev/null || true
                echo "If you need the kernel module, install linux-headers-$(uname -r) and run:"
                echo "  sudo dkms add -m hermos -v $VERSION && sudo dkms build -m hermos -v $VERSION && sudo dkms install -m hermos -v $VERSION"
                exit 0
            fi
        fi

        if ! dkms install -m hermos -v "$VERSION"; then
            echo "WARNING: DKMS install failed for kernel $(uname -r). The hermos kernel module was built but not installed."
            echo "You can retry manually with:"
            echo "  sudo dkms install -m hermos -v $VERSION"
            exit 0
        fi

        # Remove stale hermos DKMS registrations only after the new version is
        # successfully installed, so a build/install failure never leaves the
        # machine without a working module.
        for old_ver in $(dkms status -m hermos 2>/dev/null | sed -n 's/^hermos[,/] *\([^,]*\),.*/\1/p' | sort -u); do
            if [ "$old_ver" != "$VERSION" ]; then
                echo "Removing stale hermos DKMS version: $old_ver"
                dkms remove -m hermos -v "$old_ver" --all || true
            fi
        done
    ;;
esac

#DEBHELPER#

exit 0
