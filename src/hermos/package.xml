<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>hermos</name>
  <version>2.3.5</version>
  <description>
    Metapackage for Hermos: true zero-copy IPC middleware for ROS 2.
  </description>
  <maintainer email="sykwer@gmail.com">Takahiro Ishikawa-Aso</maintainer>
  <maintainer email="koichi.imai.2@tier4.jp">Koichi Imai</maintainer>
  <license>Apache License 2.0</license>

  <author email="sykwer@gmail.com">Takahiro Ishikawa-Aso</author>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend version_gte="2.3.5" version_lt="2.3.6">hermoslib</exec_depend>
  <exec_depend version_gte="2.3.5" version_lt="2.3.6">hermos_cie_config_msgs</exec_depend>
  <exec_depend version_gte="2.3.5" version_lt="2.3.6">hermos_cie_thread_configurator</exec_depend>
  <exec_depend version_gte="2.3.5" version_lt="2.3.6">hermos_components</exec_depend>
  <exec_depend version_gte="2.3.5" version_lt="2.3.6">hermos_ioctl_wrapper</exec_depend>
  <exec_depend version_gte="2.3.5" version_lt="2.3.6">hermos_sample_application</exec_depend>
  <exec_depend version_gte="2.3.5" version_lt="2.3.6">hermos_sample_interfaces</exec_depend>
  <exec_depend version_gte="2.3.5" version_lt="2.3.6">ros2hermos</exec_depend>
  <exec_depend version_gte="2.3.5" version_lt="2.3.6">ros2hermos_discovery_msgs</exec_depend>
  <exec_depend version_gte="2.3.5" version_lt="2.3.6">ros2hermos_discovery_agent</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
