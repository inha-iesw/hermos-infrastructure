#
# In-tree kbuild file used only by the CI in .github/workflows/kunit.yaml, which
# copies the Hermos sources into the kernel tree and drops this in as their
# Makefile so the KUnit suite is built into the kernel (built-in, not a module).
#
# The core object list mirrors the KUNIT_BUILD=y branch of hermos_kmod/Makefile;
# the test objects are shared via hermos_kunit/Makefile.inc, so only this list
# needs syncing when a new top-level source file is added.
obj-$(CONFIG_KUNIT) += hermos_kunit.o

hermos_kunit-objs := \
  hermos_kunit_main.o \
  hermos_main.o \
  hermos_memory_allocator.o \
  hermos_init.o \
  hermos_exit.o \
  hermos_ioctl.o \
  hermos_internal.o

include $(src)/hermos_kunit/Makefile.inc

# The built-in KUnit device retains the legacy module's permission policy.
ccflags-y += -DKUNIT_BUILD -DVERSION='"ci-kunit"' -DHERMOS_DEVICE_MODE=0666
